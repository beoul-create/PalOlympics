# PalOlympics Launcher OAuth configuration template
# Copy this file to .env for local development. Never commit .env.

# Discord Developer Portal -> OAuth2 -> Client information
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_CLIENT_SECRET=your_discord_application_client_secret

# Register this exact URI in the Discord application OAuth2 redirect list.
DISCORD_REDIRECT_URI=http://127.0.0.1:17832/callback

# The launcher reads the secret from DISCORD_CLIENT_SECRET in .env, or from this environment variable name.
# Store the actual secret in your local environment, not in source control.
DISCORD_CLIENT_SECRET_ENV_VAR=PALOLYMPICS_DISCORD_CLIENT_SECRET

# Steam OpenID callback/return URL. Steam does not require a client secret.
STEAM_OPENID_RETURN_URL=http://127.0.0.1:17832/steam/callback
